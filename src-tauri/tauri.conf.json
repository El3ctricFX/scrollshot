{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrollshot",
  "version": "0.1.0",
  "identifier": "com.scrollshot.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scrollshot",
        "width": 460,
        "height": 440,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}